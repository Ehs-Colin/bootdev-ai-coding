{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode/deepseek-v4.1-flash-free",
    "providers": {
        "opencode": {
            "models": {
                "deepseek-v4.1-flash-free": {},
            },
        },
    },
    "permissions": [
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask",
        },
        {
            "action": "run_slop",
            "resource": "*",
            "effect": "allow",
        },
        {
            "action": "shell",
            "resource": "bootdev run *",
            "effect": "allow",
        },
        {
            "action": "subagent",
            "resource": "explore",
            "effect": "deny",
        },
    ],
}
